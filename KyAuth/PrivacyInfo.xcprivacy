<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Picked up by the synchronized KyAuth folder; no pbxproj entry. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- KyAuth talks only to the KyIdentity server the user paired it with, which the user's
	     organization runs. That server sends sign-in requests through the APNs relay Worker the
	     developer runs (KyIdentity-server workers/apns), which receives this phone's APNs token
	     on every push and keeps its SHA-256 hash beyond the send (Device ID). Pushes to a pairing
	     with push keys are sealed and carry no KyIdentity IDs; a pairing without them gets
	     KyIdentity's user and device IDs in plaintext (User ID). Both serve app functionality
	     only and are linked to the user, since they are part of signing in. No tracking, analytics or crash reporter. Change this
	     together with the App Store Connect privacy label (Distribution/AppStore/app-privacy.md). -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!-- Every required-reason API in the app. Re-audit when adding one (KyAuth/AGENTS.md). -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- CA92.1: app-only settings (idle lock minutes, appearance, install marker). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- 35F9.1: ProcessInfo.systemUptime times the idle lock and the demo requests. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
		<!-- C617.1: SignOnHandoff reads modification dates of request files in the sign-on
		     App Group container to delete stale ones. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
