<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Picked up by the synchronized KyAuth folder; no pbxproj entry. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Empty: KyAuth talks only to the KyIdentity server the user paired it with, and the
	     developer runs no server, analytics or crash reporter. If that changes, this array and
	     the App Store Connect privacy label change with it. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- Every required-reason API in the app. Re-audit when adding one (KyAuth/AGENTS.md). -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- CA92.1: app-only settings (idle lock minutes, appearance, install marker). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- 35F9.1: ProcessInfo.systemUptime times the idle lock and the demo requests. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
		<!-- C617.1: SignOnHandoff reads modification dates of request files in the sign-on
		     App Group container to delete stale ones. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
